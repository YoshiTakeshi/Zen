diff --git a/verifier/verifier.go b/verifier/verifier.go
index 0d47f23..de97ba7 100644
--- a/verifier/verifier.go
+++ b/verifier/verifier.go
@@ -53,6 +53,24 @@ func (c *VerifierChip) GetChallenges(
 
 	var circuitDigest = verifierData.CircuitDigest
 
+	// (Zen patch) plonky2 >= 1.0 first observes the FRI parameters (FriParams::observe)
+	fc := c.commonData.Config.FriConfig
+	if len(fc.ConstantArityBits) != 2 {
+		panic("expected FriReductionStrategy::ConstantArityBits")
+	}
+	fp := c.commonData.FriParams
+	params := []uint64{fc.RateBits, fc.CapHeight, fc.ProofOfWorkBits, 1, fc.ConstantArityBits[0], fc.ConstantArityBits[1], fc.NumQueryRounds}
+	if fp.Hiding {
+		params = append(params, 1)
+	} else {
+		params = append(params, 0)
+	}
+	params = append(params, fp.DegreeBits)
+	params = append(params, fp.ReductionArityBits...)
+	for _, v := range params {
+		challenger.ObserveElement(gl.NewVariable(v))
+	}
+
 	challenger.ObserveBN254Hash(circuitDigest)
 	challenger.ObserveHash(publicInputsHash)
 	challenger.ObserveCap(proof.WiresCap)
